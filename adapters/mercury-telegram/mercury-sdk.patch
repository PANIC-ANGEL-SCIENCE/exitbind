+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const fixture = vi.hoisted(() => ({ sends: [] as any[], failNextSend: false, nextMessageId: 100,
+  holdSend: null as Promise<void> | null, sendStarted: null as (() => void) | null }));
+vi.mock('grammy', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('grammy')>();
+  const info = { id: 999, is_bot: true, first_name: 'Fixture', username: 'fixture_bot',
+    can_join_groups: false, can_read_all_group_messages: false, supports_inline_queries: false,
+    can_manage_bots: false, can_connect_to_business: false, has_main_web_app: false,
+    has_topics_enabled: false, allows_users_to_create_topics: false } as const;
+  class FixtureBot extends actual.Bot {
+    constructor(token: string) {
+      super(token, { botInfo: info });
+      this.api.config.use(async (_prev, method, payload) => {
+        if (method === 'sendMessage') {
+          fixture.sends.push(payload);
+          if (fixture.failNextSend) { fixture.failNextSend = false; throw new Error('fixture send lost'); }
+          const held = fixture.holdSend;
+          if (held) { fixture.sendStarted?.(); await held; }
+          return { ok: true, result: { message_id: fixture.nextMessageId++, date: 1, chat: { id: 42, type: 'private' } } } as any;
+        }
+        if (method === 'setMyCommands') return { ok: true, result: true } as any;
+        throw new Error(`Unexpected fixture API method: ${method}`);
+      });
+    }
+    async start(options?: any): Promise<void> { await options?.onStart?.(info); }
+    async stop(): Promise<void> {}
+  }
+  return { ...actual, Bot: FixtureBot };
+});
+
+import { TelegramChannel } from './telegram.js';
+import { bindOwnerBridge, type OwnerBridgeRoutingReason, type OwnerReply } from '../plugins/owner-bridge.js';
+
+const config = { channels: { telegram: { botToken: '123:fixture',
+  admins: [{ userId: 42, chatId: 42 }, { userId: 55, chatId: 55 }], members: [], pending: [] } } } as any;
+let channel: TelegramChannel;
+let active: boolean;
+let bound: ReturnType<typeof bindOwnerBridge>;
+let agent: ReturnType<typeof vi.fn>;
+let observations: OwnerBridgeRoutingReason[];
+let answers: OwnerReply[];
+let updateId: number;
+let cancelOnRouting: boolean;
+let failRouting: boolean;
+
+function update(sender: number, chat: number, text: string, reply?: { id: number; fromBot?: boolean; text?: string }) {
+  return { update_id: ++updateId, message: { message_id: updateId + 1000, date: 1,
+    chat: { id: chat, type: 'private' }, from: { id: sender, is_bot: false, first_name: 'Fixture' }, text,
+    ...(reply ? { reply_to_message: { message_id: reply.id, date: 1, chat: { id: chat, type: 'private' },
+      from: { id: reply.fromBot ? 999 : 7, is_bot: !!reply.fromBot, first_name: 'Quoted' }, text: reply.text } } : {}) } } as any;
+}
+
+async function deliver(sender: number, chat: number, text: string, reply?: { id: number; fromBot?: boolean; text?: string }) {
+  await (channel as any).bot.handleUpdate(update(sender, chat, text, reply));
+}
+
+describe('selected owner question ingress', () => {
+  beforeEach(async () => {
+    fixture.sends.length = 0; fixture.failNextSend = false; fixture.nextMessageId = 100;
+    fixture.holdSend = null; fixture.sendStarted = null;
+    active = true; updateId = 0; observations = []; answers = []; agent = vi.fn(); cancelOnRouting = false; failRouting = false;
+    channel = new TelegramChannel(config); channel.onMessage(agent);
+    await channel.start();
+    bound = bindOwnerBridge({ senderId: '42', chatId: '42', isQuestionActive: () => active,
+      onRouting: async reason => { observations.push(reason); if (cancelOnRouting) active = false; if (failRouting) throw new Error('fixture evidence unavailable'); },
+      onReply: async reply => { if (!active) return false; answers.push(reply); return true; } });
+  });
+  afterEach(async () => { bound.dispose(); await channel.stop(); });
+
+  it('requests a reply and rejects uncorrelated selected-owner text before agent dispatch', async () => {
+    const id = Number(await bound.sendQuestion('Choose?'));
+    const question = fixture.sends[0];
+    expect(question.reply_markup).toMatchObject({ force_reply: true });
+    expect(question.text).toContain('Choose?');
+    expect(question.text).toContain('Please reply directly to this message.');
+    await deliver(42, 42, 'plain owner text');
+    await deliver(42, 42, 'wrong quote', { id: id + 99, fromBot: true, text: 'ordinary' });
+    expect(agent).not.toHaveBeenCalled();
+    expect(answers).toHaveLength(0);
+    expect(observations).toEqual(['missing_reply_to', 'other_reply_to']);
+    expect(fixture.sends).toHaveLength(3);
+    expect(fixture.sends.slice(1).every(s => typeof s.text === 'string' && !s.reply_markup)).toBe(true);
